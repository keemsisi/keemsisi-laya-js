{
  "name": "@laya-js/server",
  "version": "0.1.0",
  "description": "Node adapter that turns a Laya checkpoint into an HTTP decision endpoint.",
  "keywords": [
    "laya",
    "decision-model",
    "node",
    "express",
    "nextjs",
    "onnx",
    "server"
  ],
  "license": "MIT",
  "author": "Adeshina Lasisi",
  "homepage": "https://github.com/keemsisi/keemsisi-laya-js#readme",
  "bugs": {
    "url": "https://github.com/keemsisi/keemsisi-laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemsisi/keemsisi-laya-js.git",
    "directory": "packages/server"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@laya-js/core": "0.1.0"
  },
  "optionalDependencies": {
    "@receptron/laya": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "@receptron/laya": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
