{
  "name": "@laya-js/react",
  "version": "0.1.0",
  "description": "React provider, hooks and components for the Laya decision model.",
  "keywords": [
    "laya",
    "react",
    "hooks",
    "decision-model",
    "classification",
    "typescript"
  ],
  "license": "MIT",
  "author": "Adeshina Lasisi",
  "homepage": "https://github.com/keemsisi/keemsisi-laya-js#readme",
  "bugs": {
    "url": "https://github.com/keemsisi/keemsisi-laya-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keemsisi/keemsisi-laya-js.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@laya-js/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
